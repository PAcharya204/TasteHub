<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="70dp"
        android:paddingBottom="40dp">

        <!-- LOGO -->

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:contentDescription="TasteHub Logo"/>

        <!-- APP NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TasteHub"
            android:textColor="#171717"
            android:textSize="38sp"
            android:textStyle="bold"/>

        <!-- TAGLINE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Food of your fingerprints"
            android:textColor="#555555"
            android:textSize="18sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="42dp"/>

        <!-- MOBILE NUMBER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/login_box">

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#666666"
                android:textSize="27sp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Mobile number"
                android:inputType="phone"
                android:paddingStart="12dp"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- PASSWORD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:background="@drawable/login_box">

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#666666"
                android:textSize="27sp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvPasswordVisibility"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="#666666"
                android:textSize="23sp"/>

        </LinearLayout>

        <!-- FORGOT PASSWORD -->

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:text="Forget password?"
            android:textColor="#005B63"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- LOGIN BUTTON -->

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="34dp"
            android:backgroundTint="#005B63"
            android:text="LOG IN"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="normal"
            android:textAllCaps="false"/>

        <!-- REGISTER -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New hey? "
                android:textColor="#444444"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create account"
                android:textColor="#005B63"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>