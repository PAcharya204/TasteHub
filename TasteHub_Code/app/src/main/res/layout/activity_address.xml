<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F2">

    <!-- =============================== -->
    <!-- TOP HEADER - SAME AS EDIT PROFILE -->
    <!-- =============================== -->

    <LinearLayout
        android:id="@+id/addressHeader"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#005B63">

        <!-- LOGO AND APP NAME -->

        <LinearLayout
            android:id="@+id/headerBrand"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/logo"
                android:scaleType="centerCrop"
                android:contentDescription="TasteHub Logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="TasteHub"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- BACK AND PAGE TITLE -->

        <TextView
            android:id="@+id/btnAddressBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="‹   Select Address"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- =============================== -->
    <!-- ADDRESS CONTENT -->
    <!-- =============================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PAGE DESCRIPTION -->

            <TextView
                android:id="@+id/tvAddressTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery Address"
                android:textColor="#005B63"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAddressSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose where you would like your order delivered."
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"/>

            <!-- EMPTY ADDRESS MESSAGE -->

            <TextView
                android:id="@+id/tvEmptyAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="No saved addresses yet. Add your first delivery address below."
                android:textColor="#666666"
                android:textSize="15sp"
                android:visibility="gone"/>

            <!-- SAVED ADDRESSES -->

            <RadioGroup
                android:id="@+id/rgAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- ADD NEW ADDRESS -->

            <Button
                android:id="@+id/btnAddAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="＋  Add New Address"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#087F80"
                android:minHeight="0dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </ScrollView>

    <!-- =============================== -->
    <!-- USE ADDRESS BUTTON -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnUseAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="USE THIS ADDRESS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#087F80"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

    <!-- =============================== -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- SAME AS EDIT PROFILE -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                android:tint="#005B63"
                android:contentDescription="Home"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- ORDERS -->

        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_order"
                android:tint="#005B63"
                android:contentDescription="Orders"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Orders"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:tint="#005B63"
                android:contentDescription="Profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="#005B63"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>