<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F2">

    <!-- TOP HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#005B63">

        <!-- LOGO AND APP NAME -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/logo"
                android:scaleType="centerCrop"
                android:contentDescription="TasteHub Logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="TasteHub"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- BACK AND PAGE TITLE -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="‹   Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- EDIT PROFILE CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PAGE DESCRIPTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="#005B63"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update your account details below."
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="26dp"/>

            <!-- FULL NAME -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter full name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#999999"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#087F80"/>

            <!-- EMAIL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"/>

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#999999"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#087F80"/>

            <!-- PHONE NUMBER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"/>

            <EditText
                android:id="@+id/editPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter phone number"
                android:inputType="phone"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#999999"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#087F80"/>

            <!-- SAVE BUTTON -->

            <Button
                android:id="@+id/saveChangesButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="SAVE CHANGES"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#087F80"
                android:minHeight="0dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </ScrollView>

    <!-- =============================== -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                android:tint="#005B63"
                android:contentDescription="Home"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- ORDERS -->

        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_order"
                android:tint="#005B63"
                android:contentDescription="Orders"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Orders"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:tint="#005B63"
                android:contentDescription="Profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="#005B63"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>