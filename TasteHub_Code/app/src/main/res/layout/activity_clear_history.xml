<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F2">

    <!-- FIXED TOP HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#005B63">

        <!-- LOGO -->

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:contentDescription="TasteHub Logo"/>

        <!-- TASTEHUB -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="TasteHub"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <!-- CART -->

        <ImageView
            android:id="@+id/ivCart"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/cart"
            android:scaleType="centerInside"
            android:contentDescription="Cart"/>

    </LinearLayout>

    <!-- MAIN CONTENT -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- PAGE TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear History Confirmation"
            android:textColor="#005B63"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <!-- ICON -->

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="▤"
            android:textSize="65sp"
            android:textColor="#D95C43"/>

        <!-- CONFIRMATION HEADING -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Order History?"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="25sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This will remove all your previous order history."
            android:textColor="#666666"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginTop="14dp"/>

        <!-- CANCEL AND CLEAR BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textColor="#087F80"
                android:backgroundTint="#FFFFFF"/>

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CLEAR"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D95C43"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- FIXED BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                android:tint="#005B63"
                android:contentDescription="Home"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#005B63"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ORDERS -->

        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_order"
                android:tint="#005B63"
                android:contentDescription="Orders"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Orders"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:tint="#005B63"
                android:contentDescription="Profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="#005B63"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
