<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#FFF8F1">


    <!-- ================================================= -->
    <!-- FIXED TOP HEADER -->
    <!-- ================================================= -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="95dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"

        android:background="#005B63">


        <!-- LOGO -->

        <ImageView

            android:layout_width="58dp"
            android:layout_height="58dp"

            android:src="@drawable/logo"

            android:scaleType="centerCrop"

            android:contentDescription="TasteHub Logo"/>


        <!-- TASTEHUB -->

        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="12dp"

            android:text="TasteHub"

            android:textColor="#FFFFFF"

            android:textSize="27sp"

            android:textStyle="bold"/>


        <!-- CART -->

        <ImageView

            android:id="@+id/ivCart"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:src="@drawable/cart"

            android:scaleType="centerInside"

            android:contentDescription="Cart"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- FIXED SEARCH BAR -->
    <!-- ================================================= -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="54dp"

        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:background="@drawable/login_box"

        android:paddingStart="8dp"
        android:paddingEnd="8dp">


        <!-- SEARCH ICON -->

        <TextView

            android:layout_width="40dp"
            android:layout_height="match_parent"

            android:gravity="center"

            android:text="⌕"

            android:textColor="#555555"

            android:textSize="27sp"/>


        <!-- SEARCH FIELD -->

        <EditText

            android:id="@+id/etSearch"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:background="@android:color/transparent"

            android:hint="Search in TasteHub"

            android:singleLine="true"

            android:paddingStart="5dp"
            android:paddingEnd="5dp"

            android:textColor="#333333"

            android:textColorHint="#777777"

            android:textSize="16sp"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- FIXED CATEGORY TITLE -->
    <!-- ================================================= -->

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"

        android:text="Categories"

        android:textColor="#171717"

        android:textSize="24sp"

        android:textStyle="bold"/>


    <!-- ================================================= -->
    <!-- FIXED CATEGORIES -->
    <!-- ================================================= -->

    <HorizontalScrollView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:scrollbars="none">


        <LinearLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:paddingStart="20dp"
            android:paddingEnd="20dp">


            <!-- ================= PIZZA ================= -->

            <LinearLayout

                android:id="@+id/categoryPizza"

                android:layout_width="105dp"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView

                    android:layout_width="85dp"
                    android:layout_height="75dp"

                    android:src="@drawable/img1"

                    android:scaleType="centerCrop"

                    android:contentDescription="Pizza"/>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Pizza"

                    android:textColor="#171717"

                    android:textSize="15sp"

                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= BURGER ================= -->

            <LinearLayout

                android:id="@+id/categoryBurger"

                android:layout_width="105dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView

                    android:layout_width="85dp"
                    android:layout_height="75dp"

                    android:src="@drawable/img11"

                    android:scaleType="centerCrop"

                    android:contentDescription="Burgers"/>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Burgers"

                    android:textColor="#171717"

                    android:textSize="15sp"

                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= PASTA ================= -->

            <LinearLayout

                android:id="@+id/categoryPasta"

                android:layout_width="105dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView

                    android:layout_width="85dp"
                    android:layout_height="75dp"

                    android:src="@drawable/img21"

                    android:scaleType="centerCrop"

                    android:contentDescription="Pasta"/>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Pasta"

                    android:textColor="#171717"

                    android:textSize="15sp"

                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= SNACKS ================= -->

            <LinearLayout
                android:id="@+id/categorySnacks"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="85dp"
                    android:layout_height="75dp"
                    android:src="@drawable/img29"
                    android:scaleType="centerCrop"
                    android:contentDescription="Snacks" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Snacks"
                    android:textColor="#171717"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <!-- ================= BEVERAGES ================= -->

            <LinearLayout

                android:id="@+id/categoryBeverages"

                android:layout_width="105dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView

                    android:layout_width="85dp"
                    android:layout_height="75dp"

                    android:src="@drawable/img39"

                    android:scaleType="centerCrop"

                    android:contentDescription="Beverages"/>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Beverages"

                    android:textColor="#171717"

                    android:textSize="15sp"

                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= DESSERTS ================= -->

            <LinearLayout

                android:id="@+id/categoryDesserts"

                android:layout_width="105dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:orientation="vertical">


                <ImageView

                    android:layout_width="85dp"
                    android:layout_height="75dp"

                    android:src="@drawable/img46"

                    android:scaleType="centerCrop"

                    android:contentDescription="Desserts"/>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Desserts"

                    android:textColor="#171717"

                    android:textSize="15sp"

                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ================================================= -->
    <!-- ONLY THIS PART SCROLLS -->
    <!-- ================================================= -->

    <ScrollView

        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"

        android:scrollbars="none">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- POPULAR TITLE -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"

                android:text="Popular for you"

                android:textColor="#171717"

                android:textSize="24sp"

                android:textStyle="bold"/>


            <!-- POPULAR PRODUCTS -->

            <androidx.recyclerview.widget.RecyclerView

                android:id="@+id/recyclerPopular"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="15dp"

                android:clipToPadding="false"

                android:nestedScrollingEnabled="false"/>


        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="75dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:background="#FFFFFF"

        android:elevation="8dp">


        <!-- HOME -->

        <LinearLayout

            android:id="@+id/navHome"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center">


            <ImageView

                android:layout_width="28dp"
                android:layout_height="28dp"

                android:src="@drawable/ic_home"

                android:tint="#005B63"

                android:contentDescription="Home"/>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="2dp"

                android:layout_marginTop="3dp"

                android:text="Home"

                android:textColor="#005B63"

                android:textSize="13sp"

                android:textStyle="bold" />

        </LinearLayout>


        <!-- ORDERS -->

        <LinearLayout

            android:id="@+id/navOrders"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center">


            <ImageView

                android:layout_width="28dp"
                android:layout_height="28dp"

                android:src="@drawable/ic_order"

                android:tint="#005B63"

                android:contentDescription="Orders"/>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Orders"

                android:textColor="#005B63"

                android:textSize="13sp"/>

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout

            android:id="@+id/navProfile"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center">


            <ImageView

                android:layout_width="28dp"
                android:layout_height="28dp"

                android:src="@drawable/ic_profile"

                android:tint="#005B63"

                android:contentDescription="Profile"/>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Profile"

                android:textColor="#005B63"

                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>