<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="38sp"
            android:textColor="#005B63"
            android:gravity="start|center_vertical"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:contentDescription="TasteHub Logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="TasteHub"
            android:textColor="#171717"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Reset Password"
            android:textColor="#005B63"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your registered mobile number and choose a new password."
            android:textColor="#555555"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/login_box"
            android:hint="Registered mobile number"
            android:inputType="phone"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:maxLength="10"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/login_box"
            android:hint="New Password"
            android:inputType="textPassword"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/login_box"
            android:hint="Confirm New Password"
            android:inputType="textPassword"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#005B63"
            android:text="RESET PASSWORD"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
